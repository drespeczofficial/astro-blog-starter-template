---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
		<main style="min-height:70vh;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:2rem;">
  <h1 style="font-size:4rem;margin-bottom:1rem;">DRE SPECZ</h1>

  <p style="font-size:1.25rem;max-width:600px;margin-bottom:2rem;">
    Official website currently under construction.
  </p>

  <p>
    New music, visuals, and exclusive content coming soon.
  </p>

  <div style="margin-top:2rem;">
    <a href="https://instagram.com/drespeczofficial">
      Instagram
    </a>
  </div>
</main>
		</main>
		<Footer />
	</body>
</html>
